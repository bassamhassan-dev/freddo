# Copy this file to server/.env and fill in real local values. Never commit .env.
NODE_ENV=development
PORT=5000
# MongoDB connection string. For local dev the placeholder works; for Atlas
# paste your real URI here. Never commit the .env file itself.
MONGO_URI=mongodb://localhost:27017/freddo
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
# JWT secrets for auth (Sprint 2). Generate long random strings, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Cloudinary image hosting (Sprint 16, doc 16). All three together switch
# the admin image-upload widget on; without them banners use plain image
# URLs. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
